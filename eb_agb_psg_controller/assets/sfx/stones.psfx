// a few small stones coming loose and settling.
//
// Channel 4 (noise), Short LFSR. The 7-bit register repeats every 127 steps,
// which gives noise a hard, buzzy, almost-pitched edge -- small hard
// fragments rather than a hiss. Long (15-bit) here would sound like sand.
//
// The scatter is authored as descending pitch and volume across irregular
// gaps: bright and loud first, then duller, larger-sounding pieces, then a
// last one settling. Regular spacing reads as a machine, so the gaps between
// hits are deliberately uneven (1, 2, 1, 3, 2 rows).
//
// Each hit is a note-on with a *named* instrument, which resets the channel
// to that instrument's starting volume -- that is what steps the loudness
// down. Using `..` instead would carry the decayed volume forward.

(
    version: 1,
    frames_per_tick: 1.0,
    ticks_per_row: 2,           // 2 frames ≈ 33 ms per row
    channel: Noise,

    instruments: {
        "chip":      Noise(envelope: (11, Down, 1), lfsr: Short),  // ≈ 0.17 s
        "chip_soft": Noise(envelope: (7,  Down, 1), lfsr: Short),  // ≈ 0.11 s
        "chip_last": Noise(envelope: (4,  Down, 1), lfsr: Short),  // ≈ 0.06 s
    },

    rows: [
        "A-6 chip      ---",    // first fragment: brightest, loudest
        "--- ..        ---",
        "F#6 chip_soft ---",
        "--- ..        ---",
        "--- ..        ---",
        "A#5 chip_soft ---",    // lower note = duller = reads as a bigger piece
        "--- ..        ---",
        "D-6 chip_soft ---",
        "--- ..        ---",
        "--- ..        ---",
        "--- ..        ---",
        "G-5 chip_last ---",
        "--- ..        ---",
        "--- ..        ---",
        "C-5 chip_last ---",    // last piece settles
        "--- ..        ---",
        "--- ..        ---",
        "off ..        ---",
    ],
)
