    ticks_per_row: 2,
    channel: Noise,
    instruments: {
        "boom": Noise(envelope: (15, Down, 4), lfsr: Long),
    },
    rows: [
        "C-3 boom ---",
        "skip 30",
        "off ..   ---",
    ],
)
