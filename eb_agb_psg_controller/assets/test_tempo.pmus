// Tempo-change test: R02 halves the row length from the first row.
(
    version: 1,
    frames_per_tick: 1.0,
    ticks_per_row: 4,
    order: [0],
    loop_to: Some(0),
    instruments: {
        "beep": Square(envelope: (12, Down, 0)),
